ve_dir"},"link":null},{"localized_name":"filename","name":"filename","shape":7,"type":"STRING","widget":{"name":"filename"},"link":null},{"localized_name":"timeout","name":"timeout","shape":7,"type":"INT","widget":{"name":"timeout"},"link":null}],"outputs":[{"localized_name":"本地路径","name":"本地路径","type":"STRING","links":[10]},{"localized_name":"状态","name":"状态","type":"STRING","links":[11]}],"title":"下载视频","properties":{"aux_id":"aigem/ComfyUI_LLAI_API","ver":"68e72cfc9a4e5bd25f12f5ea9642b2eda64615fb","Node name for S&R":"DownloadVideo"},"widgets_values":["","output/grok","",180]},{"id":9,"type":"PreviewVideo","pos":[2120,200],"size":[400,510],"flags":{},"order":10,"mode":0,"inputs":[{"localized_name":"video_url","name":"video_url","type":"STRING","widget":{"name":"video_url"},"link":8}],"outputs":[],"title":"视频预览","properties":{"aux_id":"aigem/ComfyUI_LLAI_API","ver":"68e72cfc9a4e5bd25f12f5ea9642b2eda64615fb","Node name for S&R":"PreviewVideo"},"widgets_values":["",""]},{"id":10,"type":"PreviewAny","pos":[2120,750],"size":[260,88],"flags":{},"order":12,"mode":0,"inputs":[{"localized_name":"源","name":"source","type":"*","link":11}],"outputs":[],"title":"下载状态","properties":{"cnr_id":"comfy-core","ver":"0.3.64","Node name for S&R":"PreviewAny"},"widgets_values":[]},{"id":11,"type":"PreviewAny","pos":[1500,440],"size":[260,120],"flags":{},"order":11,"mode":0,"inputs":[{"localized_name":"源","name":"source","type":"*","link":9}],"outputs":[],"title":"增强提示词","properties":{"cnr_id":"comfy-core","ver":"0.3.64","Node name for S&R":"PreviewAny"},"widgets_values":[]},{"id":12,"type":"MarkdownNote","pos":[250,600],"size":[320,320],"flags":{},"order":0,"mode":0,"inputs":[],"outputs":[],"title":"📖 使用说明","properties":{},"widgets_values":["## Grok 图生视频工作流\n\n### 使用步骤：\n1. **加载图片**：上传或选择图片\n2. **输入 API Key**：在右侧输入你的 API Key\n3. **编写提示词**：描述想要生成的视频内容\n4. **选择模型**：grok-video-3 或 grok-video-3-10s ⭐\n5. **执行工作流**：点击 Queue Prompt 开始生成\n6. **等待完成**：节点会自动等待视频生成完成\n7. **预览下载**：生成完成后自动预览和下载\n\n### 模型说明：\n- **grok-video-3**：标准模型（默认）\n- **grok-video-3-10s**：10秒视频专用模型\n\n### 参数说明：\n- **宽高比**：1:1（方形）、2:3（竖屏）、3:2（横屏）\n- **分辨率**：720P（推荐）、1080P（暂不支持）\n- **最大等待时间**：默认 600 秒（10分钟）\n- **轮询间隔**：默认 10 秒\n\n### 注意事项：\n- 图片 URL 必需，不能为空\n- 生成时间约 2-10 分钟\n- 确保 API Key 有效且有余额\n\n### 获取 API Key：\n访问 https://api.kuai.host/register?aff=z2C8\n"],"color":"#432","bgcolor":"#653"},{"id":13,"type":"MarkdownNote","pos":[1050,680],"size":[400,240],"flags":{},"order":1,"mode":0,"inputs":[],"outputs":[],"title":"⚙️ 节点参数说明","properties":{},"widgets_values":["## GrokImage2VideoAndWait 参数\n\n### 必需参数：\n- **images**：图片 URL（自动从上传节点获取）\n- **prompt**：视频生成提示词\n- **model**：选择 Grok 模型 ⭐ 新增\n  - grok-video-3 - 标准模型（默认）\n  - grok-video-3-10s - 10秒视频专用\n- **aspect_ratio**：视频宽高比\n  - 1:1 - 方形（社交媒体）\n  - 2:3 - 竖屏（抖音、快手）\n  - 3:2 - 横屏（YouTube、B站）\n- **size**：视频分辨率\n  - 720P - 推荐（稳定）\n  - 1080P - 暂不支持\n- **api_key**：API 密钥\n\n### 可选参数：\n- **max_wait_time**：最大等待时间（秒）\n  - 默认：600（10分钟）\n  - 范围：60-1800\n- **poll_interval**：轮询间隔（秒）\n  - 默认：10\n  - 范围：5-60\n\n### 返回值：\n- 任务ID、状态、视频URL、增强提示词\n"],"color":"#432","bgcolor":"#653"},{"id":1,"type":"LoadImage","pos":[250,200],"size":[320,360],"flags":{},"order":2,"mode":0,"inputs":[{"localized_name":"图像","name":"image","type":"COMBO","widget":{"name":"image"},"link":null},{"localized_name":"选择文件上传","name":"upload","type":"IMAGEUPLOAD","widget":{"name":"upload"},"link":null}],"outputs":[{"localized_name":"图像","name":"IMAGE","type":"IMAGE","links":[1]},{"localized_name":"遮罩","name":"MASK","type":"MASK","links":null}],"title":"加载图片","properties":{"cnr_id":"comfy-core","ver":"0.3.64","Node name for S&R":"LoadImage"},"widgets_values":["mm1.png","image"],"color":"#232","bgcolor":"#353"},{"id":3,"type":"Text Multiline","pos":[600,400],"size":[400,200],"flags":{},"order":3,"mode":0,"inputs":[{"localized_name":"文本","name":"text","type":"STRING","widget":{"name":"text"},"link":null}],"outputs":[{"label":"字符串","localized_name":"字符串","name":"STRING","type":"STRING","links"